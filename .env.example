# CONTENT ENGINE environment configuration template.
# Copy to `.env` and adjust. NEVER commit a real `.env` file.

# Application environment: development | testing | staging | production
APP_ENV=development

# HTTP listener
CE_HOST=127.0.0.1
CE_PORT=8000

# Database (SQLite by default; any SQLAlchemy URL, e.g. PostgreSQL later)
CE_DATABASE_URL=sqlite:///./data/content_engine.db

# Local storage root for downloads, renders, captions
CE_STORAGE_PATH=./data/storage

# API bearer token. Leave EMPTY in local development (auth disabled, warning logged).
# REQUIRED for any production/remote deployment - generate a long random value.
CE_API_TOKEN=

# Public base URL of this API once deployed (used for media/public links later)
CE_PUBLIC_BASE_URL=

# Comma-separated CORS origins allowed to call the API from a browser
CE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama-compatible inference endpoint (used from Phase 4 onwards)
CE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
CE_LOG_LEVEL=INFO
