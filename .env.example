# --- Core app ---
APP_ENV=development
CE_HOST=0.0.0.0
CE_PORT=8000
CE_DATABASE_URL=sqlite:///./data/content_engine.db
CE_STORAGE_PATH=./data/storage
CE_API_TOKEN=
CE_PUBLIC_BASE_URL=
CE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CE_LOG_LEVEL=INFO

# --- Phase 2: video acquisition ---
CE_MAX_SOURCE_BYTES=524288000
CE_DOWNLOAD_TIMEOUT_SECONDS=300
CE_ALLOWED_SCHEMES=http,https
CE_REQUIRE_MEDIA_PROBE=true
CE_ALLOWED_MEDIA_EXTENSIONS=mp4,mov,mkv,webm,avi,m4v
CE_MAX_ACQUISITION_ATTEMPTS=3
CE_FFPROBE_PATH=ffprobe

# --- Phase 3: transcription (faster-whisper, CPU) ---
CE_WHISPER_MODEL=tiny
CE_WHISPER_DEVICE=cpu
CE_WHISPER_COMPUTE_TYPE=int8

# --- Phase 5: rendering (FFmpeg) ---
CE_FFMPEG_PATH=ffmpeg

# --- Ollama (optional, future) ---
CE_OLLAMA_BASE_URL=http://127.0.0.1:11434
